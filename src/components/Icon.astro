---
interface Props { name: 'github' | 'sun' | 'moon' | 'arrow' | 'menu'; size?: number }
const { name, size = 20 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'github' && <path d="M9 19c-4.3 1.3-4.3-2.2-6-2.7m12 5v-3.8c0-1.1-.4-1.9-.9-2.3 3-.3 6.1-1.5 6.1-6.7 0-1.5-.5-2.7-1.4-3.7.1-.4.6-1.8-.1-3.6 0 0-1.1-.4-3.8 1.4a13 13 0 0 0-6.8 0C5.5.8 4.4 1.2 4.4 1.2c-.7 1.8-.2 3.2-.1 3.6C3.4 5.8 3 7 3 8.5c0 5.2 3.1 6.4 6.1 6.7-.4.4-.8 1.1-.9 2.1v4" />}
  {name === 'sun' && <><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></>}
  {name === 'moon' && <path d="M21 13a9 9 0 1 1-10-10 7 7 0 0 0 10 10Z"/>}
  {name === 'arrow' && <path d="M5 12h14m-6-6 6 6-6 6"/>}
  {name === 'menu' && <path d="M4 6h16M4 12h16M4 18h16"/>}
</svg>
