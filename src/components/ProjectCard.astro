---
import type { Project } from '../data/site';
import ProjectVisual from './ProjectVisual.astro';
interface Props { project: Project; index: number }
const { project, index } = Astro.props;
---
<a class="project-card" href={project.url} target="_blank" rel="noopener noreferrer">
  <div class="project-cover"><ProjectVisual project={project}/><span class="project-open" aria-hidden="true">↗</span></div>
  <div class="project-body"><div class="project-category"><span>{project.category}</span><span class="mono">{String(index + 1).padStart(2, '0')}</span></div><h3>{project.name}</h3><p>{project.description}</p><div class="project-bottom"><span class="language-dot"></span>{project.language}<span class="project-source">GitHub ↗</span></div></div>
</a>
