---
import type { projects } from '../data/site';
interface Props { project: (typeof projects)[number]; index: number }
const { project, index } = Astro.props;
---
<a class="project-card" href={project.url} target="_blank" rel="noopener noreferrer">
  <div class="project-top"><span class="project-symbol">{project.symbol}</span><span class="project-number">0{index + 1} <span>↗</span></span></div>
  <span class="project-category">{project.category}</span>
  <h3>{project.name}</h3>
  <p>{project.description}</p>
  <div class="project-bottom"><span class:list={['language-dot', project.language.toLowerCase().replace('#', 'sharp')]}></span>{project.language}<span class="project-source">开源项目</span></div>
</a>
