---
import BilibiliGallery from './BilibiliGallery.astro';
import { videoProfile, videos } from '../data/videos';
interface Props { standalone?: boolean }
const { standalone = false } = Astro.props;
const items = videos.map(video => ({ ...video, id: video.bvid }));
---
<BilibiliGallery kind="video" items={items} profileUrl={videoProfile.url} total={videoProfile.total} complete={videoProfile.complete} wide={standalone} primary={standalone}/>
