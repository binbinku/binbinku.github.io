---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { formatDate, postHref, tagHref } from '../data/paths';
import CoverArt from './CoverArt.astro';
interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
---
<article class="featured-story">
  <a class="featured-cover" href={postHref(post.id)} aria-label={`阅读精选文章：${post.data.title}`}>
    {post.data.cover ? <Image src={post.data.cover} alt="" loading="eager" /> : <CoverArt />}
  </a>
  <div class="featured-copy">
    <div class="featured-label"><span class="status-dot"></span> 精选文章 <span class="mono">FEATURED STORY</span></div>
    <div class="tag-list">{post.data.tags.map(tag => <a class="text-tag" href={tagHref(tag)}># {tag}</a>)}</div>
    <h2><a href={postHref(post.id)}>{post.data.title}</a></h2>
    <p>{post.data.description}</p>
    <div class="featured-bottom"><div class="post-meta"><span class="author-initial">BK</span><span>BK</span><span class="meta-divider">/</span><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time></div><a class="round-arrow" href={postHref(post.id)} aria-label={`打开文章：${post.data.title}`}>↗</a></div>
  </div>
</article>
