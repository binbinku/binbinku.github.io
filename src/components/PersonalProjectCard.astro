---
import AiUsageBadge from './AiUsageBadge.astro';
import CardGallery from './CardGallery.astro';
import ProjectCoverCue from './ProjectCoverCue.astro';
import type { PersonalProject } from '../data/personal-projects';
import { href } from '../data/paths';
interface Props { project: PersonalProject; index: number }
const { project, index } = Astro.props;
---
<a class="project-card personal-card" href={href(`personal-projects/${project.id}/`)}>
  <div class="project-cover"><CardGallery images={project.images}/><ProjectCoverCue/></div>
  <div class="project-body"><div class="project-category"><span>个人项目</span><span class="mono">{String(index + 1).padStart(2, '0')}</span></div><h3>{project.name}</h3><div class="project-ai-usage"><AiUsageBadge projectId={project.id}/></div><p>{project.description}</p><div class="project-bottom"><span>{project.stack.slice(0, 3).join(' / ')}</span><span class="project-source">查看详情 ↗</span></div></div>
</a>
