---
import Base from '../layouts/Base.astro';
import FeaturedStory from '../components/FeaturedStory.astro';
import BlogSidebar from '../components/BlogSidebar.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostList from '../components/PostList.astro';
import { projects } from '../data/site';
import { href } from '../data/paths';
import { getPosts } from '../data/posts';
const posts = await getPosts();
---
<Base active="home">
  <div class="container home-page">
    <header class="home-masthead"><div><p class="eyebrow">A PERSONAL SPACE FOR BUILDING & THINKING</p><h1>写代码，也写下思考<span>.</span></h1></div><p class="masthead-note"><span class="status-dot"></span> 保持好奇，持续构建</p></header>
    {posts[0] && <FeaturedStory post={posts[0]}/>}
    <div class="content-layout home-layout">
      <div class="main-feed">
        <section aria-labelledby="latest-title">
          <div class="section-heading"><div><span class="eyebrow">THE LATEST</span><h2 id="latest-title">最近更新<span class="section-count">{posts.length}</span></h2></div><a class="section-link" href={href('blog/')}>全部文章 <span>↗</span></a></div>
          {posts.length ? <PostList posts={posts.slice(0, 4)}/> : <p class="empty-state">第一篇笔记正在路上，先去看看我的项目吧。</p>}
        </section>
        <section class="home-projects" aria-labelledby="projects-title">
          <div class="section-heading"><div><span class="eyebrow">SELECTED WORK</span><h2 id="projects-title">把想法做出来<span class="section-count">{projects.length}</span></h2></div><a class="section-link" href={href('projects/')}>全部项目 <span>↗</span></a></div>
          <div class="project-grid">{projects.map((project, index) => <ProjectCard project={project} index={index}/>)}</div>
        </section>
        <div class="feed-end"><span></span><p>每一点探索，都值得留下记录。</p><span></span></div>
      </div>
      <aside class="content-sidebar" aria-label="作者与话题"><BlogSidebar/></aside>
    </div>
  </div>
</Base>
