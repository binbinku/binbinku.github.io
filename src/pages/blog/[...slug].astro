---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../data/posts';
import { href, formatDate, postHref, tagHref } from '../../data/paths';
export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, index) => ({ params: { slug: post.id }, props: { post, newer: posts[index - 1], older: posts[index + 1] } }));
}
const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter(heading => heading.depth === 2 || heading.depth === 3);
---
<Base title={post.data.title} description={post.data.description} active="blog"><div class="container article-container"><a class="back-link" href={href('blog/')}>← 返回博客</a><header class="article-heading"><div class="post-meta"><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time><span>/</span><span>BK 的笔记</span></div><h1>{post.data.title}</h1><p>{post.data.description}</p><div class="tag-list">{post.data.tags.map(tag => <a class="tag" href={tagHref(tag)}># {tag}</a>)}</div></header><div class="article-grid"><div><article class="prose"><Content /></article><nav class="post-pagination" aria-label="相邻文章">{newer && <a href={postHref(newer.id)}><small>← 上一篇</small>{newer.data.title}</a>}{older && <a href={postHref(older.id)}><small>下一篇 →</small>{older.data.title}</a>}</nav></div>{toc.length > 0 && <aside class="toc"><nav aria-label="文章目录"><p class="eyebrow">ON THIS PAGE</p><ol>{toc.map(heading => <li class:list={[{ nested: heading.depth === 3 }]}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></nav></aside>}</div></div></Base>
