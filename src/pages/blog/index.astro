---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import PersonalProjectCard from '../../components/PersonalProjectCard.astro';
import { personalProjects } from '../../data/personal-projects';
import Icon from '../../components/Icon.astro';
import { profile, projects } from '../../data/site';
import { href, postHref, formatDate } from '../../data/paths';
import { getPosts } from '../../data/posts';
const posts = await getPosts();
---
<Base title="主页" active="home">
  <div class="container hub-page">
    <aside class="hub-profile" aria-labelledby="profile-name">
      <p class="eyebrow">THE BUILDER</p>
      <img class="hub-avatar" src={profile.avatar} alt="BK 的 GitHub 头像" width="96" height="96" />
      <h1 id="profile-name">{profile.name}</h1>
      <p class="hub-handle">@{profile.handle}</p>
      <p class="hub-role"><span class="status-dot"></span>{profile.role}</p>
      <p class="hub-bio">{profile.introduction}</p>
      <a class="button button-secondary hub-github" href={profile.github} target="_blank" rel="noopener noreferrer"><Icon name="github" size={16}/>GitHub<span>↗</span></a>
      <div class="hub-profile-links"><a href={href('about/')}>更多关于我 <span>→</span></a><a href={href()}>作品放映 <span>↗</span></a></div>
    </aside>
    <div class="hub-main">
    <section aria-labelledby="projects-title">
      <header class="hub-heading"><p class="eyebrow">PINNED ON GITHUB</p><div><h2 id="projects-title">开源项目</h2><a class="section-link" href={href('projects/')}>全部项目 <span>↗</span></a></div><p>把日常问题，做成实用工具。</p></header>
      <div class="project-grid">{projects.map((project, index) => <ProjectCard project={project} index={index}/>)}</div>
    </section>
    <section class="hub-personal" id="personal-projects" aria-labelledby="personal-projects-title">
      <header class="hub-heading"><p class="eyebrow">PERSONAL PROJECTS</p><h2 id="personal-projects-title">个人项目</h2><p>游戏开发与引擎实践。</p></header>
      <div class="project-grid">{personalProjects.map((project, index) => <PersonalProjectCard project={project} index={index}/>)}</div>
    </section>
    </div>
    <aside class="hub-articles" aria-labelledby="notes-title">
      <header class="hub-heading"><p class="eyebrow">NOTES & IDEAS</p><h2 id="notes-title">文章列表</h2><p>偶尔记录，也持续探索。</p></header>
      {posts.length ? <ol class="hub-article-list">{posts.slice(0, 6).map(post => <li><a href={postHref(post.id)}><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time><h3>{post.data.title}</h3><p>{post.data.description}</p><span class="hub-read">阅读全文 <span>↗</span></span></a></li>)}</ol> : <p class="empty-state">项目在更新，笔记慢慢写。</p>}
      <a class="section-link hub-archive" href={href('writing/')}>全部文章 <span>→</span></a>
    </aside>
  </div>
</Base>
