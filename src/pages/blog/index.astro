---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import TopicBar from '../../components/TopicBar.astro';
import BlogSidebar from '../../components/BlogSidebar.astro';
import { getPosts } from '../../data/posts';
const posts = await getPosts();
---
<Base title="博客" active="blog">
  <div class="container page-content">
    <header class="page-heading"><p class="eyebrow">THE NOTEBOOK</p><h1>一些记录，一路探索<span>.</span></h1><p>关于代码、工具，以及那些值得留下的想法。</p></header>
    <div class="content-layout">
      <div class="main-feed"><TopicBar posts={posts}/>{posts.length ? <PostList posts={posts} headingLevel="h2"/> : <p class="empty-state">还没有发布文章，敬请期待。</p>}</div>
      <aside class="content-sidebar" aria-label="作者与话题"><BlogSidebar/></aside>
    </div>
  </div>
</Base>
