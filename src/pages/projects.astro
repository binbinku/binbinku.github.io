---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects, profile } from '../data/site';
---
<Base title="项目" active="projects"><div class="container page-content"><header class="page-heading"><p class="eyebrow"><span class="status-dot"></span> SELECTED WORK</p><h1>想法，<span class="accent">不止于想。</span></h1><p>一些公开的代码与项目。点击卡片，在 GitHub 查看源码。</p></header><div class="project-grid">{projects.map((project, index) => <ProjectCard project={project} index={index}/>)}</div><div class="projects-note"><span class="mono">OPEN SOURCE / OPEN POSSIBILITIES</span><a class="section-link" href={`${profile.github}?tab=repositories`} target="_blank" rel="noopener noreferrer">在 GitHub 查看更多 ↗</a></div></div></Base>
